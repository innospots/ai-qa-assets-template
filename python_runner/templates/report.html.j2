<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <title>Maestro 测试报告 - {{ summary.suite }}</title>
  <style>
    :root {
      --ok: #1b7f4b;
      --fail: #b42318;
      --bg: #f6f7f9;
      --card: #ffffff;
      --text: #1f2328;
      --muted: #656d76;
      --line: #d0d7de;
    }
    body {
      margin: 0;
      font-family: "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
      background: linear-gradient(180deg, #eef2f7 0%, var(--bg) 40%);
      color: var(--text);
    }
    .wrap { max-width: 1080px; margin: 32px auto; padding: 0 20px 48px; }
    h1 { margin: 0 0 8px; font-size: 28px; }
    .meta { color: var(--muted); margin-bottom: 20px; }
    .cards { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 24px; }
    .card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 14px 18px;
      min-width: 120px;
    }
    .card .n { font-size: 28px; font-weight: 700; }
    .ok { color: var(--ok); }
    .fail { color: var(--fail); }
    table {
      width: 100%;
      border-collapse: collapse;
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 10px;
      overflow: hidden;
    }
    th, td {
      text-align: left;
      padding: 10px 12px;
      border-bottom: 1px solid var(--line);
      vertical-align: top;
      font-size: 14px;
    }
    th { background: #f3f5f8; }
    tr:last-child td { border-bottom: none; }
    .badge {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 600;
    }
    .badge.pass { background: #dcffe4; color: var(--ok); }
    .badge.fail { background: #ffe3e0; color: var(--fail); }
    code, .mono { font-family: Consolas, "Courier New", monospace; font-size: 12px; }
    ul.checks { margin: 0; padding-left: 18px; }
    ul.checks li.bad { color: var(--fail); }
  </style>
</head>
<body>
  <div class="wrap">
    <h1>Maestro 产品测试报告</h1>
    <div class="meta">
      套件：<strong>{{ summary.suite }}</strong>
      · 生成时间：{{ summary.generated_at }}
    </div>

    <div class="cards">
      <div class="card"><div>总计</div><div class="n">{{ summary.total }}</div></div>
      <div class="card"><div>通过</div><div class="n ok">{{ summary.passed }}</div></div>
      <div class="card"><div>失败</div><div class="n fail">{{ summary.failed }}</div></div>
    </div>

    <table>
      <thead>
        <tr>
          <th>用例</th>
          <th>状态</th>
          <th>耗时</th>
          <th>校验明细</th>
          <th>产物</th>
        </tr>
      </thead>
      <tbody>
        {% for item in summary.results %}
        <tr>
          <td>
            <div><strong>{{ item.case_id }}</strong></div>
            <div class="meta">{{ item.description or '' }}</div>
            <div class="mono">{{ item.flow_path }}</div>
          </td>
          <td>
            {% if item.verify.passed %}
              <span class="badge pass">PASS</span>
            {% else %}
              <span class="badge fail">FAIL</span>
            {% endif %}
            <div class="mono">exit={{ item.run.exit_code }}</div>
          </td>
          <td>{{ '%.1f'|format((item.run.duration_ms or 0) / 1000) }}s</td>
          <td>
            <ul class="checks">
              {% for c in item.verify.checks %}
              <li class="{{ 'bad' if not c.ok else '' }}">
                {{ c.name }}: {{ c.detail }}
              </li>
              {% endfor %}
            </ul>
          </td>
          <td class="mono">{{ item.run.artifacts_dir or '-' }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</body>
</html>
